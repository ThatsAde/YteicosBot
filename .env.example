# Token del bot: Discord Developer Portal -> la tua app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: Discord Developer Portal -> la tua app -> General Information -> Application ID
CLIENT_ID=

# ID del server di test (opzionale, solo per deploy dei comandi in modalita' guild/dev).
GUILD_ID=

# Soglia dei log di processo: debug | info | warn | error (default: info)
LOG_LEVEL=

# Database per Prisma. Con il provider "sqlite" di prisma/schema.prisma il
# path e' relativo alla cartella dello schema (prisma/), non alla root:
# "file:./dev.db" crea quindi prisma/dev.db.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# Ruoli usati dall'auth service: tutti obbligatori (senza, il bot non parte).
# Il ruolo del BOT deve stare SOPRA questi nella gerarchia del server,
# e il bot deve avere "Manage Roles".
# ------------------------------------------------------------------
ROLE_PENDING=
ROLE_VERIFIED=
ROLE_SUSPENDED=
ROLE_CUSTOMER=
ROLE_PREMIUM=
ROLE_STAFF=
# Ruolo base assegnato automaticamente a ogni nuovo membro al join.
# Richiede l'intent privilegiato "Server Members Intent" abilitato su
# Developer Portal -> la tua app -> Bot -> Privileged Gateway Intents.
ROLE_MEMBER=

# ------------------------------------------------------------------
# Categorie Discord in cui vengono creati i canali ticket.
# ------------------------------------------------------------------
CATEGORY_VERIFICATION=
CATEGORY_COMMISSIONS=
CATEGORY_SUPPORT=
CATEGORY_PRIORITY_SUPPORT=
CATEGORY_MODERATION=

# ------------------------------------------------------------------
# Canali.
# ------------------------------------------------------------------
CHANNEL_TICKET_PANEL=
# Canale visibile SOLO allo staff: il bot ci pubblica il pannello di controllo
# all'avvio (e lo aggiorna al posto di duplicarlo).
CHANNEL_STAFF_DASHBOARD=
CHANNEL_ARCHIVE=
# Lista separata da virgole, mostrata nel DM di benvenuto dopo la verifica.
CHANNELS_UNLOCKED_ON_VERIFICATION=
# Canale dove il bot posta chi ha invitato ogni nuovo membro (invite logger).
CHANNEL_INVITE_LOG=

CHANNEL_LOG_AUTH=
CHANNEL_LOG_TICKET=
CHANNEL_LOG_MODERATION=
CHANNEL_LOG_PURCHASE=
CHANNEL_LOG_SYSTEM=

# ------------------------------------------------------------------
# Impostazioni ticket (tutte opzionali, con default ragionevoli).
# ------------------------------------------------------------------
TICKET_MAX_OPEN_PER_TYPE=1
TICKET_COOLDOWN_MINUTES=5
TICKET_AUTOCLOSE_WARNING_HOURS=24
TICKET_AUTOCLOSE_HOURS=48
TICKET_CLOSE_DELETE_DELAY_MINUTES=10
